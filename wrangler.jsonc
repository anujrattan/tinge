{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinge",
  "account_id": "4e320bbb0a17227a35672f23cb68be01",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "vars": {
    "NODE_ENV": "production",
    "PORT": "8787",
    "CORS_ORIGIN": "https://tinge.rattan-anuj.workers.dev",
    "FRONTEND_URL": "https://tinge.rattan-anuj.workers.dev",
    "CORS_CREDENTIALS": "true",
    "VITE_API_BASE_URL": "/api"
  },
  "alias": {
    "sharp": "./worker/shims/sharp.ts",
    "iconv-lite": "./worker/shims/iconv-lite.ts"
  },
  "observability": {
    "enabled": true
  }
}
