# Copy to .env.local and fill in real values. Do not commit .env.local.

# Google Tag Manager container ID (required for tracking)
VITE_GTM_CONTAINER_ID=GTM-XXXXXXX

# Optional: GA4 measurement ID (often configured inside GTM instead)
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXX

# Optional: Meta Pixel ID (often configured inside GTM instead)
VITE_META_PIXEL_ID=123456789
