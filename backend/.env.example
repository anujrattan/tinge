# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Supabase
# Create publishable + secret keys in Dashboard → Settings → API Keys
# https://supabase.com/docs/guides/getting-started/migrating-to-new-api-keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy JWT keys (deprecated end of 2026) — only if new keys not set yet
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT (min 32 characters) — app-issued tokens, not Supabase API keys
JWT_SECRET=change-me-in-production-use-a-long-secret
JWT_EXPIRES_IN=30m

# Redis / Upstash (optional — app continues without cache)
REDIS_URL=

# For Cloudflare Workers, prefer Upstash REST instead of REDIS_URL:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_ADMIN_EMAIL=

# AI Image Enhancement & Mockups (optional; studio local upscaler works without these)
# OPENROUTER_API_KEY=
# OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
# FAL_KEY=
